 archivebox/core/permissions.py                | 34 ++++++++++-
 archivebox/core/urls.py                       |  4 ++
 archivebox/core/views.py                      | 57 ++++++++++++++++++-
 archivebox/templates/admin/base.html          |  2 +
 .../templates/admin/user_scope_banner.html    | 24 ++++++++
 6 files changed, 120 insertions(+), 6 deletions(-)
 create mode 100644 archivebox/templates/admin/user_scope_banner.html

