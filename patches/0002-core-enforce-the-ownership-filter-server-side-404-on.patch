+            {% if USER_SCOPE.see_all %}
+                <input type="hidden" name="see_all" value="0">
+                <button type="submit" style="cursor:pointer;padding:4px 10px;border-radius:7px;border:1px solid #cbd5e1;background:#fff;font-size:12px;font-weight:600;">Back to only mine</button>
+            {% else %}
+                <input type="hidden" name="see_all" value="1">
+                <button type="submit" style="cursor:pointer;padding:4px 10px;border-radius:7px;border:1px solid #cbd5e1;background:#fff;font-size:12px;font-weight:600;">See every user</button>
+            {% endif %}
+        </form>
+    {% endif %}
+</div>
