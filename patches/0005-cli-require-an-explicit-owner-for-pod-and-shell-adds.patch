From 84f4978b979675ac2c9ec34c3bb790942d754db2 Mon Sep 17 00:00:00 2001
From: homelab <homelab@emrys.dev>
Date: Thu, 26 Nov 2026 02:56:29 -0600
Subject: [PATCH 5/7] cli: require an explicit owner for pod and shell adds

An add with no owner would produce untagged, invisible snapshots, so the
CLI refuses instead: --user <name> or ARCHIVEBOX_ADD_USER. The web form and
the API pass a real created_by and are unaffected.
---
 archivebox/cli/archivebox_add.py      | 21 ++++++++++++++++++---
 archivebox/cli/archivebox_crawl.py    |  7 +++++--
 archivebox/cli/archivebox_snapshot.py |  7 +++++--
 archivebox/cli/archivebox_update.py   |  9 +++++++++
 4 files changed, 37 insertions(+), 7 deletions(-)

diff --git a/archivebox/cli/archivebox_add.py b/archivebox/cli/archivebox_add.py
index 7c6fe5972..2aa8b48dc 100644
--- a/archivebox/cli/archivebox_add.py
+++ b/archivebox/cli/archivebox_add.py
@@ -69,9 +69,15 @@ def add(
     index_only: bool = False,
     bg: bool = False,
     created_by_id: int | None = None,
+    user: str = "",
     config: dict[str, Any] | None = None,
 ) -> tuple[Crawl, QuerySet[Snapshot]]:
-    """Add a URL list or imported URL document to a new Crawl."""
+    """Add a URL list or imported URL document to a new Crawl.
+
+    ``user`` (or ``ARCHIVEBOX_ADD_USER``) names the owner of the resulting
+    ``user-<name>`` tags when the caller has no authenticated user. An add with
+    neither is refused: an unattributed crawl's snapshots would be invisible.
+    """
 
     from rich import print
 
@@ -105,14 +111,16 @@ def add(
 
     # import models once django is set up
     from archivebox.crawls.models import Crawl
-    from archivebox.base_models.models import get_or_create_system_user_pk
     from archivebox.personas.models import Persona
     from archivebox.misc.logging_util import printable_filesize
     from archivebox.misc.system import get_dir_size
     from archivebox.core.shutdown_util import foreground_parent_watchdog, foreground_shutdown_signals
     from django.utils import timezone
 
-    created_by_id = created_by_id or get_or_create_system_user_pk()
+    # Owner of the crawl, and therefore of every user-<name> tag its snapshots get.
+    from archivebox.core.user_scope import resolve_created_by_id
+
+    created_by_id = resolve_created_by_id(created_by_id, username=user)
     started_at = timezone.now()
 
     if isinstance(urls, str):
@@ -357,6 +365,13 @@ def add(
 @click.option("--plugins", "-p", default="", help="Comma-separated list of plugins to run e.g. title,favicon,screenshot,singlefile,...")
 @click.option("--extract", default="", help="Comma-separated plugins or output types to extract e.g. title,pdf,text/html,image,...")
 @click.option("--persona", default="Default", help="Authentication profile to use when archiving")
+@click.option(
+    "--user",
+    "user",
+    default="",
+    help="Owner of the added snapshots (recorded as a user-<name> tag). Defaults to ARCHIVEBOX_ADD_USER; "
+    "an add with neither is refused, because untagged snapshots are invisible to everyone.",
+)
 @click.option(
     "--only-new/--no-only-new",
     "only_new",
diff --git a/archivebox/cli/archivebox_crawl.py b/archivebox/cli/archivebox_crawl.py
index 5e703c3ec..140b138cf 100644
--- a/archivebox/cli/archivebox_crawl.py
+++ b/archivebox/cli/archivebox_crawl.py
@@ -66,10 +66,13 @@ def create_crawl(
     """
     from archivebox.misc.jsonl import read_args_or_stdin, write_record, TYPE_CRAWL
     from archivebox.misc.util import validate_url
-    from archivebox.base_models.models import get_or_create_system_user_pk
     from archivebox.crawls.models import Crawl
 
-    created_by_id = created_by_id or get_or_create_system_user_pk()
+    # An explicit owner is required: these commands create work whose snapshots are
+    # tagged user-<name>, and an unattributed add would be invisible to everyone.
+    from archivebox.core.user_scope import resolve_created_by_id
+
+    created_by_id = resolve_created_by_id(created_by_id)
     is_tty = sys.stdout.isatty()
 
     # Collect all input records
diff --git a/archivebox/cli/archivebox_snapshot.py b/archivebox/cli/archivebox_snapshot.py
index a3a8fca29..75b8a59cd 100644
--- a/archivebox/cli/archivebox_snapshot.py
+++ b/archivebox/cli/archivebox_snapshot.py
@@ -125,11 +125,14 @@ def create_snapshots(
         TYPE_CRAWL,
     )
     from archivebox.misc.util import validate_url
-    from archivebox.base_models.models import get_or_create_system_user_pk
     from archivebox.core.models import Snapshot
     from archivebox.crawls.models import Crawl
 
-    created_by_id = created_by_id or get_or_create_system_user_pk()
+    # An explicit owner is required: these commands create work whose snapshots are
+    # tagged user-<name>, and an unattributed add would be invisible to everyone.
+    from archivebox.core.user_scope import resolve_created_by_id
+
+    created_by_id = resolve_created_by_id(created_by_id)
     is_tty = sys.stdout.isatty()
 
     # Collect all input records
diff --git a/archivebox/cli/archivebox_update.py b/archivebox/cli/archivebox_update.py
index 1beaf5950..9d4d55ebb 100644
--- a/archivebox/cli/archivebox_update.py
+++ b/archivebox/cli/archivebox_update.py
@@ -51,6 +51,7 @@ def _get_search_indexing_plugins() -> list[str]:
 
 
 def _build_filtered_snapshots_queryset(
+    snapshot_scope=None,
     **kwargs,
 ):
     from archivebox.cli.archivebox_snapshot import build_snapshot_queryset
@@ -58,6 +59,10 @@ def _build_filtered_snapshots_queryset(
     limit = kwargs.pop("limit", None)
     reverse = kwargs.pop("reverse", False)
     snapshots = build_snapshot_queryset(**kwargs)
+    if snapshot_scope is not None:
+        # Per-user isolation: a filtered update can only reach the snapshots the
+        # caller may already see. Used by POST /api/v1/cli/update.
+        snapshots = snapshots.filter(pk__in=snapshot_scope.values("pk"))
     snapshots = snapshots.order_by(kwargs.get("sort") or "-created_at", "-id")
     if reverse:
         snapshots = snapshots.reverse()
@@ -168,6 +173,7 @@ def update(
     rescan: bool = False,
     reverse: bool = False,
     stop_daemon_stack: bool = True,
+    snapshot_scope: QuerySet[Snapshot, Snapshot] | None = None,
 ) -> None:
     """
     Update the database without forcing a filesystem scan by default.
@@ -266,6 +272,7 @@ def update(
 
                     if is_filtered_update:
                         snapshots = _build_filtered_snapshots_queryset(
+                            snapshot_scope=snapshot_scope,
                             filter_patterns=filter_patterns,
                             filter_type=filter_type,
                             status=status,
@@ -360,6 +367,7 @@ def update(
                     from archivebox.cli.rescan import reconcile_known_snapshots
 
                     snapshots = _build_filtered_snapshots_queryset(
+                        snapshot_scope=snapshot_scope,
                         filter_patterns=filter_patterns,
                         filter_type=filter_type,
                         status=status,
@@ -381,6 +389,7 @@ def update(
                         print("[*] No search indexing plugins are available, nothing to backfill.")
                     else:
                         snapshots = _build_filtered_snapshots_queryset(
+                            snapshot_scope=snapshot_scope,
                             filter_patterns=filter_patterns,
                             filter_type=filter_type,
                             status=status,
